# Copy to .env and fill in real values. NEVER commit .env.

# ---- Required ----
DISCORD_BOT_TOKEN=your_discord_bot_token_here
CLIP_CHANNEL_ID=1547317591796748288

# Streamer slug -> Discord channel ID for auto-clip announcements (comma separated)
STREAMER_CHANNELS=streamername:1234567890123456789,anotherstreamer:9876543210987654321

# ---- Upload / public download ----
UPLOAD_CHANNEL_ID=1547844146822127626
UPLOAD_SERVER_URL=http://localhost:8766

# ---- Auto clip monitor ----
# Poll cadence in seconds (minimum 5). Each pass starts this often.
AUTO_CLIP_POLL_SECONDS=30

# ---- Whisper (captions) ----
WHISPER_BACKEND=faster        # faster | openai
WHISPER_MODEL=base            # tiny | base | small ...
WHISPER_DEVICE=cpu            # cpu | cuda (auto if unset)
WHISPER_COMPUTE_TYPE=int8     # int8 on CPU, float16 on CUDA

# ---- FFmpeg / hardware encode ----
# true enables a *verified* hardware encoder (amf/nvenc/qsv/vaapi), falls back to CPU
AUTO_HW_ENCODE=true

# ---- Infrastructure (optional, safe defaults) ----
# CACHE_ROOT=./cache
# JOB_ROOT=./temp/jobs
# LOG_DIR=./logs
# CACHE_TTL=86400
# TEMP_MAX_AGE=21600
# FFMPEG_TIMEOUT=1800
# JOB_MAX_ATTEMPTS=3
# MAX_CONCURRENT_DOWNLOADS=8
# MAX_CONCURRENT_ANALYSIS=2
# MAX_CONCURRENT_EDITS=6
